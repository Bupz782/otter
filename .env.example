# Example environment configuration for the Otter backend.
# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# Core RPC / vault configuration
# ---------------------------------------------------------------------------
# Option A: legacy single-network fallback.
OTTER_RPC_URL=http://127.0.0.1:8545
OTTER_VAULT_ADDRESS=0x...

# Option B: multi-network EVM config (preferred).
# Format: name=rpc_url|vault_address|chain_id[|bridge_address],...
# OTTER_NETWORKS=default=http://127.0.0.1:8545|0x...|31337

# ---------------------------------------------------------------------------
# Agent signing key
# ---------------------------------------------------------------------------
OTTER_PRIVATE_KEY=0x...

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
OTTER_DATABASE_URL=sqlite://./otter.db
# OTTER_DATABASE_URL=postgres://user:pass@localhost/otter

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
OTTER_API_PORT=3001
OTTER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication (optional)
# ---------------------------------------------------------------------------
# Address that automatically receives the Owner role on sign-in.
# OTTER_AUTH_OWNER_ADDRESS=0x...

# ---------------------------------------------------------------------------
# Private-transaction MEV searcher V1
# ---------------------------------------------------------------------------
# Optional private-transaction RPC for MEV searcher V1 (Flashbots Protect,
# MEV-Blocker). When set, intent transactions are routed through this endpoint.
# OTTER_MEV_SEARCHER_ENABLED=true
# OTTER_MEV_SEARCHER_RPC_URL=https://rpc.flashbots.net/fast

# ---------------------------------------------------------------------------
# Real bundle-based MEV searcher V2 (Flashbots-compatible relay)
# ---------------------------------------------------------------------------
# When enabled, the API exposes POST /api/v1/mev/bundle.
# OTTER_MEV_BUNDLE_ENABLED=true
# OTTER_MEV_BUNDLE_RELAY_URL=https://relay.flashbots.net
# OTTER_MEV_BUNDLE_PRIVATE_KEY=[REDACTED]
# OTTER_MEV_BUNDLE_BENEFICIARY=0x...
# Backrun monitor: auto-submit a rebate bundle per pending tx hitting the target.
# OTTER_MEV_BUNDLE_TARGET_ADDRESS=0x...
# OTTER_MEV_BUNDLE_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# On-chain solvency registry
# ---------------------------------------------------------------------------
# On-chain SolvencyRegistry address (used by /api/v1/solvency/status).
# OTTER_SOLVENCY_REGISTRY=0x...

# ---------------------------------------------------------------------------
# Solana attestation adapter (optional, requires the `solana` feature)
# ---------------------------------------------------------------------------
OTTER_SOLANA_ENABLED=false
# OTTER_SOLANA_RPC_URL=https://api.devnet.solana.com
# OTTER_SOLANA_PROGRAM_ID=AttReg1111111111111111111111111111111111111
# OTTER_SOLANA_AUTHORITY_KEYPAIR=[REDACTED]
# Interval between scheduler attestations of the solvency Merkle root (min 60s).
# OTTER_SOLANA_ATTEST_INTERVAL_SECS=3600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RUST_LOG=info
