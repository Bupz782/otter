# Otter API testnet configuration
OTTER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OTTER_CHAIN_ID=11155111
OTTER_NETWORK=sepolia

# DelegationVault contract deployed on Sepolia.
# The previous V1 addresses are stale after the target_contract circuit change.
# Run the deployment script in contracts/ and set the new vault address here.
# OTTER_VAULT_ADDRESS=0x...

# Agent private key — prefer keystore or private-key file in production.
# Precedence: OTTER_KEYSTORE_FILE > OTTER_PRIVATE_KEY_FILE > OTTER_PRIVATE_KEY.
# Set this value from a secure source (e.g., a secrets manager or mounted file);
# never commit a real private key to version control.
# OTTER_PRIVATE_KEY=set-in-secrets-manager
# OTTER_PRIVATE_KEY_FILE=/run/secrets/otter_private_key
# OTTER_KEYSTORE_FILE=/run/secrets/otter-agent-keystore.json
# OTTER_KEYSTORE_PASSWORD=
# OTTER_PRIVATE_KEY_SOURCE=env-file

# Path where the agent persists its delegation nonce across restarts.
OTTER_NONCE_STORE_PATH=./otter-nonce.txt

# Storage backend. SQLite remains the default for tests and local dev.
# Use a Postgres URL to run against PostgreSQL (see docker-compose.yml).
OTTER_DATABASE_URL=./otter.db
# OTTER_DATABASE_URL=postgres://otter:otter@localhost:5432/otter

# Tool versions (read by setup scripts)
# NOIR_VERSION is read from .noir-version
# BB_VERSION is read from .bb-version

# Noir / Barretenberg tooling paths on the host
OTTER_CIRCUIT_DIR=./delegation_circuit
OTTER_NARGO_BIN=/usr/local/bin/nargo
# Barretenberg is installed via bbup at ~/.bb/bb by default.
OTTER_BB_BIN=/Users/$USER/.bb/bb

# Feature flags
OTTER_EXECUTION_ENABLED=false
OTTER_DELEGATE_ON_CREATE=false
OTTER_METRICS_ENABLED=true
OTTER_MONITORING_INTERVAL_SECS=60

# Authentication (SIWE + JWT). When OTTER_AUTH_ENABLED=true, OTTER_JWT_SECRET
# is mandatory on public networks (mainnet/sepolia): the API refuses to start
# without it. Locally, a random dev secret is generated if unset.
# OTTER_AUTH_OWNER_ADDRESS grants the Owner role to that address.
OTTER_AUTH_ENABLED=false
# OTTER_JWT_SECRET=set-in-secrets-manager
# OTTER_JWT_TTL_HOURS=24
# OTTER_AUTH_OWNER_ADDRESS=0x...

RUST_LOG=info
# Set to `json` for structured logs in production.
# Multi-network EVM configuration: name=rpc|vault|chainid,...
# OTTER_NETWORKS=default=http://localhost:8545|0x...|31337,arbitrum_sepolia=https://...|0x...|421614

# Optional private-transaction RPC for MEV searcher V1 (Flashbots Protect,
# MEV-Blocker). When set, intent transactions are routed through this endpoint.
# OTTER_MEV_SEARCHER_ENABLED=true
# OTTER_MEV_SEARCHER_RPC_URL=https://rpc.flashbots.net/fast

# On-chain SolvencyRegistry address (used by /api/v1/solvency/status).
# OTTER_SOLVENCY_REGISTRY=0x...

OTTER_LOG_FORMAT=text

# Supervision (profil `monitoring` de docker-compose) : canal de signalement
# des alertes Alertmanager. Exemples : https://hc-ping.com/<uuid>
# (healthchecks.io), https://ntfy.sh/<topic>, ou tout endpoint HTTP maison.
# Tester la chaine avec scripts/test-alert.sh.
# ALERT_WEBHOOK_URL=https://hc-ping.com/<uuid>
